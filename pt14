    position: absolute;
    top: -3px;
    left: -3px;

    width: 20px !important;
    height: 20px !important;

    opacity: 1;
    cursor: pointer;
}

.pf-like-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    pointer-events: none;
}

