/* Header line - simple inline text */
.ask-header-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px 10px 4px;
}

.ask-meta-text {
  font-family: "Plus Jakarta Sans", sans-serif;
  font-size: 11px;
  line-height: 1;
}

.ask-label {
  color: rgba(17,17,17,0.4);
  font-weight: 400;
}

.ask-user-name {
  color: #111111 !important;
  font-weight: 600;
  text-decoration: none !important;
  margin-left: 2px;
  transition: opacity 0.2s ease;
}

.ask-user-name:hover {
  opacity: 0.6;
}

.ask-decorator {
  color: rgba(17,17,17,0.15);
  font-size: 10px;
}

/* The actual ask message box - uses a soft tint plate instead of heavy shadows */
.ask-message-plate {
  width: 100%;
  background: rgba(17,17,17,0.02);
  border: 1px solid rgba(17,17,17,0.015);
  border-radius: 12px;
  padding: 16px;
  box-sizing: border-box;
  margin-bottom: 16px;
}

.ask-content-body {
  font-family: "Plus Jakarta Sans", sans-serif;
  font-size: 11.5px;
  font-weight: 400;
  line-height: 1.6;
  color: #2c2c2c;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

/* Response area - clean typography divided by a soft hairline */
.response-plate {
  width: 100%;
  padding: 8px 4px 4px 4px;
  border-top: 1px solid rgba(17,17,17,0.05);
  box-sizing: border-box;
}

.response-content-body {
  font-family: "Plus Jakarta Sans", sans-serif;
  font-size: 11.5px;
  font-weight: 400;
  line-height: 1.65;
  color: {color:text};
  word-wrap: break-word;
  overflow-wrap: break-word;
}

/* Text formatting, link anchors, and images */
.ask-content-body img,
.response-content-body img {
  width: 100%;
  height: auto;
  display: block;
  margin-top: 12px;
  border-radius: 6px;
}

.response-content-body p {
  margin-top: 0 !important;
  margin-bottom: 12px;
}

.response-content-body p:last-child {
  margin-bottom: 0 !important;
}

.response-content-body a {
  color: inherit;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

.response-content-body a:hover {
  opacity: 0.6;
}

