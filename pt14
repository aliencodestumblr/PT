/* Monochrome glitch title */

.desc-nexus-title {
    position: relative;
    display: inline-block;
    max-width: 100%;

    font-family: "Orbitron", sans-serif;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 1px;
    text-transform: uppercase;

    color: {color:text};
    overflow-wrap: anywhere;
    isolation: isolate;

    animation: title-flicker 4s infinite steps(1, end);
}

.desc-nexus-title::before,
.desc-nexus-title::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    color: {color:text};
    background: transparent;
    pointer-events: none;
}

.desc-nexus-title::before {
    animation: title-glitch-top 3.2s infinite linear alternate-reverse;
}

.desc-nexus-title::after {
    animation: title-glitch-bottom 2.7s infinite linear alternate;
}

.sb-verified {
    display: inline-flex;
    align-items: center;
    gap: 5px;

    color: var(--sb-muted);
    font-size: 8px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 1.25px;
    text-transform: uppercase;
}

.sb-verified i {
    font-size: 10px;
    color: #555;
    margin-top:-1px;
}

.snake-avatar {
    position: absolute;
    z-index: 5;

    top: 50%;
    right: -17px;

    display: block;
    width: 47px;
    height: 47px;

    transform: translateY(-50%);
    border-radius: 50%;
    text-decoration: none;
    isolation: isolate;
    box-sizing: border-box;
}

.snake-avatar img {
    position: absolute;
    z-index: 2;
    inset: 0;

    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;

    border: 1px solid rgba(0, 0, 0, .09);
    border-radius: 50%;
    box-sizing: border-box;

    transition: filter .4s ease, transform .4s ease;
}

.snake-avatar-ring {
    position: absolute;
    z-index: 1;
    inset: -4px;

    border: 1px solid transparent;
    border-radius: 50%;
    box-sizing: border-box;

    background:
        linear-gradient(
            var(--sb-paper),
            var(--sb-paper)
        ) padding-box,
        conic-gradient(
            from 0deg,
            transparent 0deg,
            rgba(120, 120, 120, .45) 90deg,
            rgba(23, 23, 23, .55) 150deg,
            rgba(160, 160, 160, .4) 210deg,
            transparent 300deg,
            rgba(85, 85, 85, .35) 340deg,
            transparent 360deg
        ) border-box;

    animation: snakeCoil 12s linear infinite;
    opacity: .75;

    transition: opacity .35s ease;
}

.snake-avatar:hover .snake-avatar-ring {
    opacity: 1;
}

.snake-avatar:hover img {
    filter: contrast(1.06);
    transform: scale(.95);
}

@keyframes snakeCoil {
    to { transform: rotate(360deg); }
}

@keyframes title-glitch-top {
    0%, 88%, 92%, 100% {
        clip-path: inset(0 0 0 0);
        transform: translate(0);
    }

    89% {
        clip-path: inset(10% 0 65% 0);
        transform: translate(-2px, 0);
    }

    90% {
        clip-path: inset(45% 0 35% 0);
        transform: translate(2px, -1px);
    }

    91% {
        clip-path: inset(75% 0 8% 0);
        transform: translate(-1px, 1px);
    }
}

@keyframes title-glitch-bottom {
    0%, 82%, 86%, 100% {
        clip-path: inset(0 0 0 0);
        transform: translate(0);
    }

    83% {
        clip-path: inset(55% 0 20% 0);
        transform: translate(2px, 1px);
    }

    84% {
        clip-path: inset(15% 0 65% 0);
        transform: translate(-2px, 0);
    }

    85% {
        clip-path: inset(35% 0 45% 0);
        transform: translate(1px, -1px);
    }
}

@keyframes title-flicker {
    0%, 94%, 96%, 98%, 100% {
        opacity: 1;
        text-shadow: none;
    }

    95% {
        opacity: .75;
        text-shadow: 1px 0 #fff;
    }

    97% {
        opacity: .9;
        text-shadow: -1px 0 #fff;
    }
}

