<script>
(function () {
    function initAskPopup() {
        const popup = document.getElementById("popup-ask");
        const overlay = document.getElementById("fade-ask");

        if (!popup || !overlay || popup.dataset.initialized === "true") {
            return;
        }

        popup.dataset.initialized = "true";

        const closeButton = popup.querySelector(".ask-close");
        const inboxLink = document.querySelector(
            ".snake-menu-panel a.poplight"
        );

        function openAsk(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            popup.classList.add("is-visible");
            overlay.classList.add("is-visible");

            popup.setAttribute("aria-hidden", "false");
            overlay.setAttribute("aria-hidden", "false");

            document.body.style.overflow = "hidden";

            if (closeButton) {
                closeButton.focus();
            }
        }

        function closeAsk() {
            popup.classList.remove("is-visible");
            overlay.classList.remove("is-visible");

            popup.setAttribute("aria-hidden", "true");
            overlay.setAttribute("aria-hidden", "true");

            document.body.style.overflow = "";
        }

        if (inboxLink) {
            inboxLink.addEventListener("click", openAsk);
        }

        if (closeButton) {
            closeButton.addEventListener("click", closeAsk);
        }

        overlay.addEventListener("click", closeAsk);

        document.addEventListener("keydown", function (event) {
            if (
                event.key === "Escape" &&
                popup.classList.contains("is-visible")
            ) {
                closeAsk();
            }
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAskPopup);
    } else {
        initAskPopup();
    }
})();
</script>


<script>
(function () {
    function startMusicPlayer() {
        const audio = document.getElementById("acMiniAudio");
        const playButton = document.getElementById("acMiniToggle");
        const nextButton = document.getElementById("sbNext");
        const titleElement = document.getElementById("acMiniTitle");
        const artistElement = document.getElementById("acMiniArtist");
        const playlist = document.getElementById("sbPlaylist");

        if (!audio || !playButton || !nextButton ||
            !titleElement || !artistElement || !playlist) {
            console.error("Music player: One or more required HTML elements are missing.");
            return;
        }

        const tracks = Array.from(playlist.querySelectorAll(".sb-track"))
            .map(function (item) {
                return {
                    src: (item.getAttribute("data-src") || "").trim(),
                    title: (item.getAttribute("data-title") || "").trim(),
                    artist: (item.getAttribute("data-artist") || "").trim()
                };
            })
            .filter(function (track) {
                return track.src.length > 0;
            });

        let currentIndex = 0;

        function setButton(playing) {
            playButton.innerHTML = playing
                ? '<i class="ph ph-pause" aria-hidden="true"></i>'
                : '<i class="ph ph-play" aria-hidden="true"></i>';

            playButton.setAttribute(
                "aria-label",
                playing ? "Pause music" : "Play music"
            );
        }

        function loadTrack(index, autoplay) {
            if (tracks.length === 0) {
                titleElement.textContent = "No tracks found";
                artistElement.textContent = "Check your playlist settings";
                setButton(false);
                console.error(
                    "Music player: No tracks with audio URLs found. Check #sbPlaylist and the Track Audio settings."
                );
                return;
            }

            currentIndex = (index + tracks.length) % tracks.length;
            const track = tracks[currentIndex];

            titleElement.textContent = track.title || "Untitled";
            artistElement.textContent = track.artist || "Unknown artist";

            audio.pause();
            audio.src = track.src;
            audio.load();
            setButton(false);

            if (autoplay) {
                audio.play().catch(function (error) {
                    console.error("Music playback failed:", error);
                });
            }
        }

        playButton.addEventListener("click", function () {
            if (!tracks.length) {
                loadTrack(0, false);
                return;
            }

            if (audio.paused) {
                if (!audio.getAttribute("src")) {
                    loadTrack(currentIndex, true);
                } else {
                    audio.play().catch(function (error) {
                        console.error("Music playback failed:", error);
                    });
                }
            } else {
                audio.pause();
            }
        });

        nextButton.addEventListener("click", function () {
            loadTrack(currentIndex + 1, true);
        });

        audio.addEventListener("play", function () {
            setButton(true);
        });

        audio.addEventListener("pause", function () {
            setButton(false);
        });

        audio.addEventListener("ended", function () {
            loadTrack(currentIndex + 1, true);
        });

        audio.addEventListener("error", function () {
            console.error("Music player: The audio file could not be loaded:", audio.src);
        });

        if (tracks.length) {
            loadTrack(0, false);
            console.log("Music player loaded", tracks.length, "track(s).");
        } else {
            titleElement.textContent = "No tracks found";
            artistElement.textContent = "Check your playlist settings";
            console.error(
                "Music player: No usable audio URLs were found in #sbPlaylist."
            );
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startMusicPlayer);
    } else {
        startMusicPlayer();
    }
})();
</script>

