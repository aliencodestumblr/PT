/* ---------------- POST CONTAINER ---------------- */

.entry {
  width: 600px;
  height: auto;
  margin: 0 auto !important;

  {block:PermalinkPage}
  width: 540px;
  border-radius: 12px;
  margin: 0 auto !important;
  {/block:PermalinkPage}
}

#posts {
  width: 600px;
  margin: 30px auto 50px auto !important;
  transform: translateX(-90px);

  transition: opacity 0s, filter 0s;

  {block:PermalinkPage}
  width: 540px;
  margin: 55px auto 0 auto !important;
  transform: translateX(-50px);
  border: 0;
  {/block:PermalinkPage}
}

/* ---------------- POST CARDS ---------------- */

.posts {
  box-sizing: border-box;
  width: 270px;
  margin: 15px;
  margin-bottom: 15px;
  padding: 11px;

  overflow: hidden;
  opacity: 1;

  background: #fff;
  border: 1px solid #e8e8e8;
  border-radius: 5px;

  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.035),
    0 2px 6px rgba(0, 0, 0, 0.018);

  transition:
    opacity .45s ease,
    transform .45s ease,
    box-shadow .28s ease;

  {block:PermalinkPage}
  width: 540px;
  margin: 25px auto 0 auto;
  padding: 0;

  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  {/block:PermalinkPage}
}

/* ---------------- POST MEDIA ---------------- */

.posts img,
.posts video,
.posts iframe {
  max-width: 100%;
}

/* Rounded media inside grid cards */
#posts .posts img {
  border-radius: 5px;
}

/* Keep permalink-page media unaffected */
{block:PermalinkPage}
#posts .posts img {
  border-radius: 0;
}
{/block:PermalinkPage}

/* ---------------- SUBTLE HOVER ---------------- */

@media (hover: hover) {
  #posts .posts:hover {
    box-shadow:
      0 14px 32px rgba(0, 0, 0, 0.045),
      0 3px 8px rgba(0, 0, 0, 0.025);
  }
}

/* ---------------- LINHA DO USUÁRIO NO TOPO DO POST ---------------- */
.post-top{
  margin: 2px 0 10px 0;

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:0;

  font-family:"Rajdhani",sans-serif;
  font-size:9px;
  letter-spacing:1.6px;
  text-transform:uppercase;

  opacity:.68;
}
.post-top a{
  color:{color:text};
  text-decoration:none;
  font-weight:800;
}

.post-top a:hover{
  opacity:.6;
}

/* --------- TAMANHOS DE IMAGEM + VÍDEO / NÃO ALTERAR --------- */
.posts img{
  width:100%;
  {block:permalinkpage}
  width:100%;
  {/block:permalinkpage}
  transition:1s;
}

.video{
  width:100%;
  {block:permalinkpage}
  width:100%;
  {/block:permalinkpage}
}

.vsanna{ display:none; }


/* ---------------- ROLAGEM INFINITA ---------------- */
#infscr-loading{
  position:absolute;
  bottom:0;
  margin-left:50%;
  left:0px;
  text-align:center;
}

#infscr-loading img{
  display:none;
  width:20px;
  height:20px;
}


/* EFEITO DE CARREGAMENTO SUAVE */
{block:IndexPage}
.posts{
  transition: opacity .75s ease, transform .75s ease;
}

.posts.is-ready{
  opacity:1;
  transform: translateY(0);
}
{/block:IndexPage}
/* FIM DO EFEITO DE CARREGAMENTO SUAVE */


/* ---------------- BARRA DE ROLAGEM ---------------- */
::-webkit-scrollbar{ width:8px; } ::-webkit-scrollbar-track{ background: transparent; } ::-webkit-scrollbar-thumb{ background: transparent; border-radius: 3px; } .is-scrolling ::-webkit-scrollbar-thumb{ background: {color:Accent}; } .is-scrolling ::-webkit-scrollbar-thumb:hover{ box-shadow: 0 0 6px rgba({RGBcolor:Accent}, .45); } *{ scrollbar-width: thin; scrollbar-color: transparent transparent; } .is-scrolling{ scrollbar-color: {color:Accent} transparent; }


/* ---------------- PAGINAÇÃO ---------------- */
.page-nav{
  width:min(700px, calc(100% - 40px));
  margin:50px auto 80px!important;

  display:flex;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
  gap:6px;

  font-family:"Rajdhani",sans-serif;
  font-size:9px;
  font-weight:800;
  letter-spacing:1.4px;
  text-transform:uppercase;
}

.page-nav a,
.page-nav span{
  min-width:31px;
  height:30px;
  padding:0 10px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:rgba(255,255,255,.04);
  border:1px solid {color:Borders};
  border-radius:2px;

  color:{color:Links};
  text-decoration:none!important;

  box-sizing:border-box;

  transition:.22s ease;
}

.page-nav a:hover{
  background:{color:Links};
  border-color:{color:Links};
  color:#000;
  transform:translateY(-2px);
}

.page-nav .current_page{
  background:{color:Links};
  border-color:{color:Links};
  color:#000;
}

.page-nav .prev,
.page-nav .next{
  min-width:68px;
}

.page-nav .disabled{
  opacity:.25;
  pointer-events:none;
}


/* ---------------- PERMALINK DO POST (INFERIOR) ---------------- */

{block:IndexPage}

.post-footer {
    width: 100%;
    margin: 12px 0 0 !important;
    padding: 9px 0 1px !important;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;

    box-sizing: border-box;
    overflow: hidden;

    border-top: 1px solid {color:borders} !important;
    background: transparent !important;

    font-family: "Rajdhani", sans-serif;
}

.post-footer *,
.post-footer *::before,
.post-footer *::after {
    box-sizing: border-box;
}

/* LEFT — LOG / NOTES */

.pf-left {
    display: flex;
    align-items: center;
    gap: 7px;

    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.pf-notes {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    margin: 0;
    padding: 0;

    color: {color:text} !important;
    text-decoration: none !important;
    white-space: nowrap;

    opacity: .8;
    transition: opacity .2s ease;
}

.pf-notes:hover {
    opacity: 1;
}

.pf-lab {
    color: {color:text};

    font-family: "Orbitron", sans-serif;
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 1.1px;
    line-height: 1;
}

.pf-num {
    color: #c5c5c5;

    font-family: "Orbitron", sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .4px;
    line-height: 1;
}

.pf-note-label {
    padding-left: 7px;
    border-left: 1px solid {color:borders};

    color: {color:text};

    font-size: 10px;
    font-weight: 500;
    letter-spacing: .6px;
    line-height: 1;
}

/* RIGHT — ARCHIVE CONTROLS */

.pf-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;

    flex: 0 0 auto;
    margin: 0;
    padding: 0;
}

.pf-btn {
    position: relative;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 14px;
    height: 16px;
    flex: 0 0 14px;

    margin: 0;
    padding: 0;

    border: 0;
    border-radius: 0;
    background: transparent;

    color: {color:text} !important;
    text-decoration: none !important;

    opacity: .65;
    cursor: pointer;

    transition:
        opacity .2s ease,
        color .2s ease;
}

.pf-btn > i,
.pf-like-text > i {
    display: block;
    font-size: 13px;
    line-height: 1;
    font-style: normal;
}

.pf-btn:hover {
    color: #e0e0e0 !important;
    opacity: 1;
}

/* TUMBLR LIKE BUTTON — FUNCTIONAL */

.pf-like-wrapper {
    overflow: hidden;
}

.pf-like-wrapper .like_button {
    position: absolute;
    inset: 0;
    z-index: 2;

    display: block;
    width: 100%;
    height: 100%;

    opacity: 0;
