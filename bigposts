<script>
(function($){
  if(!window.jQuery) return;

  var $win = $(window);
  var $container = $('#posts');
  if(!$container.length) return;

  if($container.data('acInitDone') === 1) return;
  $container.data('acInitDone', 1);

  var layoutTimer = null;
  var scanTimer = null;
  var mutationObserver = null;

  // Clear legacy styles and inject media post header hide rule (removed absolute positioning override)
  $('#ac-hover-script-safety, #ac-single-script-safety, #ac-clean-top-permalink-style, #ac-final-single-style, #ac-final-masonry-style, #ac-masonry-structural-style').remove();

  $('<style id="ac-masonry-structural-style">' +
    '.posts.ac-prep { visibility: hidden !important; opacity: 0 !important; pointer-events: none !important; z-index: -1 !important; }' +
    '.posts.is-ready { visibility: visible; opacity: 1; pointer-events: auto; }' +
    '.ac-media-post .post-top, .ac-media-post .post-header, .ac-media-post .user-info, .ac-media-post .username, .ac-media-post .avatar { display: none !important; }' + 
  '</style>').appendTo('head');

  function safe(fn){ try{ fn(); }catch(e){} }

  function throttle(fn, wait){
    var t = null;
    return function(){
      if(t) return;
      t = setTimeout(function(){
        t = null;
        fn();
      }, wait);
    };
  }

  function scopePosts($scope){
    $scope = ($scope && $scope.length) ? $scope : $(document);
    return $scope.filter('.posts').add($scope.find('.posts'));
  }

  // Detects if a post contains photo/video elements to separate text from media
  function hasMedia($post){
    if(!$post || !$post.length) return false;

    if($post.find('.photo-slideshow,.media-wrap,.npf_photoset,.npf_grid,.npf_container,.npf_group,.npf_row,.npf_col,.npf_image,.tmblr-full,figure.tmblr-full,.npf_video_container,.npf_video,video').length){
      return true;
    }

    return $post.find('img,iframe').filter(function(){
      var $el = $(this);
      if($el.closest('#sidebar,#topbar,.cc,#ltop,.sb-card,.brand-icon').length) return false;

      var src = (
        $el.attr('src') ||
        $el.attr('srcset') ||
        $el.attr('data-src') ||
        ''
      ).toLowerCase();

      return (
        src.indexOf('media.tumblr.com') !== -1 ||
        src.indexOf('64.media.tumblr.com') !== -1 ||
        src.indexOf('va.media.tumblr.com') !== -1 ||
        src.indexOf('tumblr.com/video') !== -1 ||
        src.indexOf('youtube.com') !== -1 ||
        src.indexOf('vimeo.com') !== -1
      );
    }).length > 0;
  }

  // Applies random width between 540px and 1100px to individual posts
  function assignRandomWidths($scope){
    var $posts = scopePosts($scope);
    $posts.each(function(){
      var $p = $(this);
      if(!$p.data('randomWidthAssigned')){
        var minWidth = 540;
        var maxWidth = 1100;
        var randomW = Math.floor(Math.random() * (maxWidth - minWidth + 1)) + minWidth;
        $p.css('width', randomW + 'px');
        $p.data('randomWidthAssigned', true);
      }
    });
  }

  function initPhotosets($scope){
    $scope = ($scope && $scope.length) ? $scope : $(document);
    if(!$.fn.pxuPhotoset) return;

    $scope.find('.photo-slideshow').each(function(){
      if(this._acPXUInited) return;
      this._acPXUInited = true;

      $(this).pxuPhotoset({
        lightbox:true,
        rounded:false,
        gutter:'1px',
        photoset:'.photo-slideshow',
        photoWrap:'.photo-data',
        photo:'.pxu-photo'
      });
    });
  }

  function initUnnest($scope){
    if(!$.fn.unnest) return;

    var $posts = scopePosts($scope);
    if(!$posts.length) return;

    $posts.each(function(){
      var $post = $(this);
      if($post.data('acUnnestDone') === 1) return;

      $post.data('acUnnestDone', 1);

      $post.unnest({
        yourCaption:".caption",
        wrapName:".tumblr_parent",
        newCaptionUsername:false,
        originalPostCaptionUsername:false,
        tumblrAvatars:false,
        tumblrAvatarsName:".tumblr_avatar",
        usernameColon:false
      });
    });
  }

  function cleanupNPFMediaUrls($scope){
    $scope = ($scope && $scope.length) ? $scope : $(document);
    $scope.find('a[href]').each(function(){
      var $a = $(this);
      var hrefRaw = $a.attr('href') || '';
      var href = hrefRaw.toLowerCase();
      var txt = $.trim($a.text() || '');

      var isMedia =
        href.indexOf('64.media.tumblr.com/') !== -1 ||
        href.indexOf('va.media.tumblr.com/') !== -1 ||
        href.indexOf('media.tumblr.com/') !== -1;

      if(!isMedia) return;

      if(txt && ($.trim(hrefRaw) === txt || $.trim(href) === txt.toLowerCase()) && $a.children().length === 0){
        var $p = $a.closest('p');
        if($p.length && $.trim($p.text()) === txt) $p.remove();
        else $a.remove();
      }
    });
  }

  // Tags posts based on media presence and moves footers inside the post container
  function classifyAndMoveFooter($scope) {
    scopePosts($scope).each(function(){
      var $post = $(this);
      var isMediaPost = hasMedia($post);

      $post.toggleClass('ac-media-post', isMediaPost)
           .toggleClass('ac-text-post', !isMediaPost);

      var $footer = $post.find('.post-footer').first();
      if($footer.length) {
        $footer.appendTo($post);
      }
    });
  }

  function forceEager($scope){
    $scope = $scope && $scope.length ? $scope : $(document);
    $scope.find('img[loading="lazy"]').each(function(){
      try{ this.loading = 'eager'; }catch(e){}
      $(this).attr('loading','eager');
    });
    $scope.find('iframe[loading="lazy"]').each(function(){
      $(this).attr('loading','eager');
    });
  }

  function processPosts($scope){
    var $posts = scopePosts($scope);
    if(!$posts.length) return;

    forceEager($posts);
    assignRandomWidths($posts);

    safe(function(){ initPhotosets($posts); });
    safe(function(){ initUnnest($posts); });
    safe(function(){ cleanupNPFMediaUrls($posts); });
    safe(function(){ classifyAndMoveFooter($posts); });

    watchMediaLoads($posts);
  }

  function scanForNewPosts(){
    if(scanTimer) clearTimeout(scanTimer);

    scanTimer = setTimeout(function(){
      scanTimer = null;

      var $new = $container.children('.posts').filter(function(){
        return !$(this).data('acScanned');
      });

      if(!$new.length) return;

      $new.each(function(){
        $(this).data('acScanned', 1);
      });

      hidePosts($new);
      processPosts($new);

      if($.fn.imagesLoaded){
        $new.imagesLoaded(function(){
          showPosts($new);
          layoutPosts();
          runSettledLayouts();
        });
      } else {
        showPosts($new);
        layoutPosts();
        runSettledLayouts();
      }
    }, 90);
  }

  function getColumnCount(){
    return 1;
  }

  function layoutPosts(){
    var $items = $container.children('.posts');
    if(!$items.length) return;

    var containerWidth =
      Math.round($container.width()) ||
      Math.round($container.parent().width()) ||
      Math.round($win.width());

    var currentTop = 0;

    $items.each(function(){
      var $item = $(this);

      var itemWidth = Math.ceil($item.outerWidth(true) || 0);
      var itemHeight =
        Math.ceil($item.outerHeight(true)) ||
        Math.ceil(this.getBoundingClientRect().height) ||
        1;

      currentTop += itemHeight;
    });
  }

  function requestLayout(){
    if(layoutTimer) clearTimeout(layoutTimer);
    layoutTimer = setTimeout(function(){
      layoutTimer = null;
      layoutPosts();
    }, 90);
  }

  function hidePosts($posts){
    if(!$posts || !$posts.length) return;
    $posts
      .removeClass('is-ready')
      .addClass('ac-prep')
      .css({
        visibility:'hidden',
        opacity:0,
        pointerEvents:'none',
        zIndex:-1
      });
  }

  function showPosts($posts){
    if(!$posts || !$posts.length) return;
    $posts
      .removeClass('ac-prep')
      .addClass('is-ready')
      .css({
        visibility:'',
        opacity:'',
        pointerEvents:'',
        zIndex:1
      });
  }

  function layoutAndReveal($posts){
    processPosts($posts);

    function reveal(){
      showPosts($posts);
      layoutPosts();
      setTimeout(function(){ layoutPosts(); }, 180);
      setTimeout(function(){ layoutPosts(); }, 700);
      setTimeout(function(){ layoutPosts(); }, 1400);
    }

    if($.fn.imagesLoaded){
      $posts.imagesLoaded(function(){
        reveal();
      });
    } else {
      reveal();
    }
  }

  function watchMediaLoads($items){
    if(!$items || !$items.length) return;
    $items.find('img').each(function(){
      if(this._acHoverWatchBound) return;
      this._acHoverWatchBound = true;

      this.addEventListener('load', requestLayout, false);
      this.addEventListener('error', requestLayout, false);
    });
    $items.find('iframe').each(function(){
      if(this._acHoverWatchBound) return;
      this._acHoverWatchBound = true;

      this.addEventListener('load', requestLayout, false);
    });
  }

  function runSettledLayouts(){
    var delays = [180, 500, 1000, 1800];
    for(var i=0;i<delays.length;i++){
      setTimeout(function(){
        layoutPosts();
      }, delays[i]);
    }
  }

  function bindLayoutEvents(){
    $win.off('.acMasonryWin');
    $win.on('scroll.acMasonryWin', throttle(function(){
      scanForNewPosts();
    }, 160));
    $win.on('resize.acMasonryWin', throttle(function(){
      requestLayout();
    }, 220));
  }

  function initMutationObserver(){
    if(!window.MutationObserver) return;

    if(mutationObserver){
      try{ mutationObserver.disconnect(); }catch(e){}
    }

    mutationObserver = new MutationObserver(function(mutations){
      var found = false;
      for(var i=0;i<mutations.length;i++){
        if(mutations[i].addedNodes && mutations[i].addedNodes.length){
          found = true;
          break;
        }
      }
      if(found) scanForNewPosts();
    });

    try{
      mutationObserver.observe($container[0], {
        childList:true,
        subtree:false
      });
    }catch(e){}
  }

  function initInfiniteScrollIfPresent(){
    if(!$.fn.infinitescroll) return;
    if(!document.getElementById('next')) return;
    if(!document.getElementById('pagination')) return;

    $container.infinitescroll({
      navSelector:'#pagination',
      nextSelector:'#next',
      itemSelector:'.posts',
      loading:{
        selector:'#infscr-loading',
        img:'',
        msgText:'',
        finishedMsg:''
      },
      bufferPx:1200,
      appendCallback:false
    }, function(newElements){
      var $new = $(newElements).filter('.posts');

      if(!$new.length){
        $new = $(newElements).find('.posts');
      }

      if(!$new.length) return;

      $new.each(function(){
        $(this).data('acScanned', 1);
      });

      $new
        .removeClass('is-ready')
        .addClass('ac-prep')
        .css({
          visibility:'hidden',
          opacity:0,
          pointerEvents:'none',
          display:'block',
          zIndex:-1
        });

      $container.append($new);

      forceEager($new);
      layoutAndReveal($new);
      runSettledLayouts();
    });
  }

  $(document).ready(function(){
    var $initial = $container.children('.posts');

    $initial.each(function(){
      $(this).data('acScanned', 1);
    });

    hidePosts($initial);

    bindLayoutEvents();
    initMutationObserver();

    forceEager($initial);
    layoutAndReveal($initial);
    initInfiniteScrollIfPresent();
    runSettledLayouts();

    setTimeout(function(){
      showPosts($initial);
      layoutPosts();
    }, 800);

    setTimeout(function(){
      showPosts($initial);
      layoutPosts();
    }, 1800);

    setTimeout(function(){
      showPosts($initial);
      layoutPosts();
    }, 3000);
  });

})(window.jQuery);
</script>
{/block:IndexPage}

